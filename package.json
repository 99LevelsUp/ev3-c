{
    "name": "ev3-c",
    "displayName": "EVƎ C",
    "description": "Write, build, and run C programs on LEGO EV3 bricks with the original firmware",
    "version": "0.0.1",
    "publisher": "99LevelsUp",
    "repository": {
        "type": "git",
        "url": "https://github.com/99LevelsUp/ev3-c"
    },
    "engines": {
        "vscode": "^1.95.0",
        "node": ">=20.0.0"
    },
    "categories": [
        "Programming Languages",
        "Other"
    ],
    "extensionDependencies": [
        "99LevelsUp.ev3-cockpit"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Building runs a compiler on the workspace's source files, so EVƎ C does not build until you trust the workspace."
        }
    },
    "activationEvents": [
        "workspaceContains:ev3c.json"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "ev3-c.build",
                "title": "Build",
                "category": "EV3 C"
            },
            {
                "command": "ev3-c.upload",
                "title": "Upload",
                "category": "EV3 C"
            },
            {
                "command": "ev3-c.run",
                "title": "Run",
                "category": "EV3 C"
            },
            {
                "command": "ev3-c.stop",
                "title": "Stop",
                "category": "EV3 C"
            },
            {
                "command": "ev3-c.emergencyStop",
                "title": "Emergency Stop",
                "category": "EV3 C"
            },
            {
                "command": "ev3-c.showRuns",
                "title": "Show Runs",
                "category": "EV3 C"
            },
            {
                "command": "ev3-c.deleteRuns",
                "title": "Delete Runs",
                "category": "EV3 C"
            },
            {
                "command": "ev3-c.checkToolchain",
                "title": "Check Toolchain",
                "category": "EV3 C"
            }
        ],
        "configuration": {
            "title": "EVƎ C",
            "properties": {
                "ev3-c.brick": {
                    "type": "string",
                    "default": "active",
                    "markdownDescription": "The brick EVƎ C uploads to and runs on: `active` for the brick that is active in EVƎ Cockpit, or a brick id as EVƎ Cockpit lists it."
                },
                "ev3-c.toolchain.path": {
                    "type": "string",
                    "default": "",
                    "scope": "machine",
                    "markdownDescription": "Path to a Zig compiler to build with instead of the pinned one EVƎ C downloads on first use. Leave empty to use the pinned compiler. Run **EV3 C: Check Toolchain** to check it."
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc",
        "lint": "eslint src --ext .ts",
        "build:dev": "esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --outfile=out/extension.js --sourcemap",
        "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --outfile=out/extension.js",
        "test:unit": "node scripts/run-unit-tests.cjs",
        "test:ci": "npm run compile && npm run lint && npm run test:unit",
        "test:native": "npm run compile && node scripts/run-native-tests.cjs",
        "build:runtime": "npm run compile && node scripts/build-runtime.cjs",
        "watch": "tsc --watch"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "@types/vscode": "^1.95.0",
        "@typescript-eslint/eslint-plugin": "^7.16.0",
        "@typescript-eslint/parser": "^7.16.0",
        "esbuild": "^0.21.0",
        "eslint": "^8.57.0",
        "typescript": "^5.5.0"
    },
    "dependencies": {
        "@ev3-cockpit/client": "file:.cockpit-client/ev3-cockpit-client.tgz"
    }
}
